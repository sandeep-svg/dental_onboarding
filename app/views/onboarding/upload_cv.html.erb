<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-semibold text-gray-900 mb-2">Upload your CV</h1>
  <p class="text-gray-600 mb-6">We will automatically fill in as much of your candidate profile as possible. You can review and edit everything before saving.</p>

  <% if flash[:alert] %>
    <div class="bg-red-100 border border-red-200 text-red-700 rounded-md px-4 py-3 mb-6 text-sm"><%= flash[:alert] %></div>
  <% end %>

  <div data-controller="cv-upload" data-max-cv-size-mb="<%= ENV.fetch('MAX_CV_SIZE_MB', 25) %>">
    <%= form_with url: onboarding_upload_cv_path, method: :post, local: true, multipart: true do |form| %>
      <%= form.file_field :file, accept: ".pdf,.doc,.docx", class: "hidden", data: { cv_upload_target: "input" } %>

      <div data-cv-upload-target="dropzone" class="border-2 border-dashed border-gray-300 rounded-lg p-8 text-center cursor-pointer hover:border-blue-500 hover:bg-blue-50 transition" data-action="click->cv-upload#openFilePicker">
        <div class="text-gray-400 mb-2">
          <svg class="mx-auto h-12 w-12" stroke="currentColor" fill="none" viewBox="0 0 48 48">
            <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <p class="text-sm text-gray-600">Drag & drop your CV here, or click to browse</p>
        <p class="text-xs text-gray-400 mt-1">Supported: PDF, DOC, DOCX (max 25 MB)</p>
      </div>

      <p data-cv-upload-target="fileInfo" class="text-sm mt-2"></p>

      <div class="mt-4 flex items-center gap-4">
        <%= form.submit "Upload CV", data: { cv_upload_target: "submitBtn" }, class: "inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 cursor-pointer" %>

        <div data-cv-upload-target="processing" class="hidden flex items-center gap-2 text-sm text-gray-600">
          <svg class="animate-spin h-5 w-5 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
          Processing your CV...
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-6">
    <%= button_to "Continue manually", onboarding_continue_manual_path, method: :post, class: "text-sm text-blue-600 hover:text-blue-800 underline bg-transparent border-none cursor-pointer" %>
  </div>
</div>
