<div class="max-w-7xl mx-auto">
  <h1 class="text-2xl font-semibold text-gray-900 mb-6">Candidates</h1>

  <div class="bg-white shadow-sm border border-gray-200 rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">City</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Job function</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Search status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created at</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @candidates.each do |candidate| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= candidate.first_name %> <%= candidate.last_name %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600"><%= candidate.email %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600"><%= candidate.city %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600"><%= candidate.job_function&.dig(:name) %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600"><%= candidate.search_status&.humanize %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600"><%= candidate.created_at.to_date %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">
              <%= link_to "View", admin_candidate_path(candidate), class: "text-blue-600 hover:text-blue-800 underline" %>
            </td>
          </tr>
        <% end %>
        <% if @candidates.empty? %>
          <tr>
            <td colspan="7" class="px-6 py-8 text-center text-sm text-gray-500">No candidates found.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @pagy.pages > 1 %>
    <div class="mt-4">
      <%== pagy_nav(@pagy) %>
    </div>
  <% end %>
</div>
