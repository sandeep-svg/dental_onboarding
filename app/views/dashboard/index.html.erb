<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-semibold text-gray-900 mb-2">Welcome, <%= @profile&.first_name.presence || current_user.email %></h1>

  <div class="bg-white shadow-sm border border-gray-200 rounded-lg p-6 mt-6">
    <% if @profile&.onboarding_completed? %>
      <div class="flex items-center gap-2 text-green-700 mb-4">
        <span class="inline-block w-3 h-3 rounded-full bg-green-500"></span>
        <span class="font-medium">Profile completed</span>
      </div>
      <p class="text-sm text-gray-600 mb-4">Your candidate profile is complete and visible to recruiters.</p>
      <div class="flex flex-wrap gap-3">
        <%= link_to "View profile", onboarding_review_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
        <% if @document&.file&.attached? %>
          <%= link_to "Download CV", rails_blob_path(@document.file, disposition: "attachment"), class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
        <% end %>
      </div>
    <% else %>
      <div class="flex items-center gap-2 text-amber-700 mb-4">
        <span class="inline-block w-3 h-3 rounded-full bg-amber-500"></span>
        <span class="font-medium">Profile not completed</span>
      </div>
      <p class="text-sm text-gray-600 mb-4">You haven't completed your onboarding yet. Please finish setting up your profile.</p>
      <%= link_to "Complete profile", onboarding_review_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
    <% end %>
  </div>
</div>
